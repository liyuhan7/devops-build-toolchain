{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/contracts/artifact.schema.json",
  "title": "Artifact",
  "type": "object",
  "required": ["artifact_id", "type", "uri", "media_type", "producer_job_id", "repository_commit", "configuration_id"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "uri": { "type": "string", "minLength": 1 },
    "media_type": { "type": "string", "minLength": 1 },
    "producer_job_id": { "type": "string", "minLength": 1 },
    "repository_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "configuration_id": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
